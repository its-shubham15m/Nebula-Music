<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true">

    <!-- Header: Clean & Balanced (Reduced vertical padding) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/sidebar_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:padding="12dp"
            app:tint="?attr/colorOnSurface"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nebula Player"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface"/>

        <!-- Invisible view for balance -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <!-- Quick Action Cards (Reduced height and padding) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:baselineAligned="false">

        <!-- Favorites -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_favorites"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#673AB7">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_favorites_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Favorite Album Art"
                    android:src="@drawable/default_album_art"
                    android:alpha="0.8"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_favorite_filled"
                        app:tint="@android:color/white"
                        android:contentDescription="Favorites Icon" />
                    <TextView
                        android:id="@+id/card_fav_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favorites"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:id="@+id/card_fav_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="15 songs"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Playlists -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_playlists"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#4CAF50">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_playlists_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_album_art"
                    android:scaleType="centerCrop"
                    android:alpha="0.8"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_playlist"
                        app:tint="@android:color/white"
                        android:contentDescription="Playlists Icon" />
                    <TextView
                        android:id="@+id/card_playlist_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Playlists"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:id="@+id/card_playlist_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3 playlists"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_recent"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FF9800">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/img_recent_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/default_album_art"
                    android:scaleType="centerCrop"
                    android:alpha="0.8"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_recent"
                        app:tint="@android:color/white"
                        android:contentDescription="Recent Icon" />
                    <TextView
                        android:id="@+id/card_recent_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                    <TextView
                        android:id="@+id/card_recent_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3 songs"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Category Tabs (Reduced vertical padding) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/categories_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tab_songs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Songs"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tab_artists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Artists"
                android:textSize="18sp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_albums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Albums"
                android:textSize="18sp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_genres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genres"
                android:textSize="18sp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Action Bar (Reduced vertical padding) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <!-- Shuffle Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shuffle_all_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/shuffle_card_background">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/btn_shuffle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/shuffle"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="Shuffle All" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shuffle All"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Sorting Tools -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_sort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sort"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Sort"
                android:padding="8dp"/>

            <ImageButton
                android:id="@+id/btn_select"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_select_off"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Select"
                android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/music_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>