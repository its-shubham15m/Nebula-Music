<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/main_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="160dp">

                <LinearLayout
                    android:id="@+id/layout_header_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="24dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/app_icon"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CornerRound"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nebula Player"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="24dp">

                        <TextView
                            android:id="@+id/tv_orbit_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good Evening, "
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_orbit_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="User"
                            android:textSize="24sp"
                            android:fontFamily="sans-serif"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingStart="24dp"
                        android:clipToPadding="false"
                        android:layout_marginBottom="32dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/chip_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutline"
                                app:cardBackgroundColor="?attr/colorSurface"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="All"
                                    android:textColor="?attr/colorOnSurface"
                                    android:paddingHorizontal="24dp"
                                    android:paddingVertical="10dp"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium"/>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/chip_music"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutline"
                                app:cardBackgroundColor="?android:attr/colorBackground"
                                android:layout_marginEnd="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Music"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:paddingHorizontal="24dp"
                                    android:paddingVertical="10dp"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium"/>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/chip_video"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutline"
                                app:cardBackgroundColor="?android:attr/colorBackground"
                                android:layout_marginEnd="24dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Videos"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:paddingHorizontal="24dp"
                                    android:paddingVertical="10dp"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif-medium"/>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_section_time_warp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_time_warp_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Picks"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="24dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingStart="24dp"
                        android:clipToPadding="false"
                        android:layout_marginBottom="40dp">
                        <LinearLayout
                            android:id="@+id/container_time_warp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            tools:layout_height="120dp"
                            tools:layout_width="match_parent"
                            tools:background="#E0E0E0"/>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_section_artists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_artists_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your Top Artists"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="24dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingStart="24dp"
                        android:clipToPadding="false"
                        android:layout_marginBottom="40dp">
                        <LinearLayout
                            android:id="@+id/container_artists"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            tools:layout_height="120dp"
                            tools:layout_width="match_parent"
                            tools:background="#E0E0E0"/>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_section_echo_chamber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_echo_chamber_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Curated For You"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="24dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingStart="24dp"
                        android:clipToPadding="false"
                        android:layout_marginBottom="40dp">
                        <LinearLayout
                            android:id="@+id/container_echo_chamber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            tools:layout_height="120dp"
                            tools:layout_width="match_parent"
                            tools:background="#E0E0E0"/>
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_section_stellar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_stellar_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Music Videos"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="24dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingStart="24dp"
                        android:clipToPadding="false"
                        android:layout_marginBottom="40dp">
                        <LinearLayout
                            android:id="@+id/container_stellar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            tools:layout_height="120dp"
                            tools:layout_width="match_parent"
                            tools:background="#E0E0E0"/>
                    </HorizontalScrollView>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>